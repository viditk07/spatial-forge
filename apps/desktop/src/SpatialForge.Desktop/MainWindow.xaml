<Window x:Class="SpatialForge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpatialForge" Width="1280" Height="820" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#141E27" BorderBrush="#263847" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="SPATIALFORGE" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="LOCAL 3D RECONSTRUCTION" Foreground="{StaticResource AccentBrush}"
                               FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <Button Content="Dashboard" HorizontalContentAlignment="Left"
                            Command="{Binding DashboardCommand}" />
                    <Button Content="New project" HorizontalContentAlignment="Left"
                            Command="{Binding NewProjectCommand}" />
                    <Button Content="Hardware" HorizontalContentAlignment="Left"
                            Command="{Binding HardwareCommand}" />
                    <Button Content="Model review" HorizontalContentAlignment="Left"
                            Command="{Binding ModelReviewCommand}" />
                    <Button Content="Settings" HorizontalContentAlignment="Left"
                            Command="{Binding SettingsCommand}" />
                </StackPanel>
                <Border Grid.Row="3" Background="#102D29" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="● LOCAL ONLY" Foreground="#56C59A" FontWeight="SemiBold" />
                        <TextBlock Text="No photos leave this computer" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
