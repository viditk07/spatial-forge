<Application x:Class="SpatialForge.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SpatialForge.Desktop.ViewModels;assembly=SpatialForge.Desktop.Core"
             xmlns:views="clr-namespace:SpatialForge.Desktop.Views">
    <Application.Resources>
        <Color x:Key="BackgroundColor">#10171F</Color>
        <Color x:Key="PanelColor">#18232E</Color>
        <Color x:Key="RaisedColor">#21303D</Color>
        <Color x:Key="AccentColor">#31A6D8</Color>
        <Color x:Key="TextColor">#F1F5F8</Color>
        <Color x:Key="SecondaryTextColor">#9EB0BF</Color>
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#304556" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0E151C" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="#385064" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0E151C" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewProjectViewModel}"><views:NewProjectView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ImageReviewViewModel}"><views:ImageReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProcessingViewModel}"><views:ProcessingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelReviewViewModel}"><views:ModelReviewView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HardwareViewModel}"><views:HardwareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ErrorViewModel}"><views:ErrorView /></DataTemplate>
    </Application.Resources>
</Application>
