<UserControl x:Class="SpatialForge.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" AutomationProperties.Name="SpatialForge settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32" MaxWidth="1160">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Settings" Style="{StaticResource PageTitle}" /><TextBlock Text="Privacy, processing preferences and local project maintenance." Style="{StaticResource PageSubtitle}" /></StackPanel>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="12" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SETTINGS" Style="{StaticResource Eyebrow}" Margin="10,8,0,8" />
                        <Border Background="{StaticResource AccentSoft}" BorderBrush="#2E6680" BorderThickness="1" CornerRadius="8" Padding="12,10"><TextBlock Text="General" Foreground="{StaticResource AccentPrimary}" FontWeight="SemiBold" /></Border>
                        <TextBlock Text="Privacy" Foreground="{StaticResource TextSecondary}" Margin="12,15,0,0" />
                        <TextBlock Text="Reconstruction" Foreground="{StaticResource TextSecondary}" Margin="12,15,0,0" />
                        <TextBlock Text="Storage" Foreground="{StaticResource TextSecondary}" Margin="12,15,0,0" />
                        <TextBlock Text="Diagnostics" Foreground="{StaticResource TextSecondary}" Margin="12,15,0,0" />
                        <TextBlock Text="About" Foreground="{StaticResource TextSecondary}" Margin="12,15,0,8" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid><StackPanel><TextBlock Text="Privacy" Style="{StaticResource SectionTitle}" /><TextBlock Text="A local-only product by design." Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><Border Style="{StaticResource SuccessBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource StatusSuccess}" Margin="0,0,6,0" /><TextBlock Text="Protected" Foreground="{StaticResource StatusSuccess}" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border></Grid>
                            <Separator Margin="0,16,0,14" />
                            <TextBlock Text="{Binding PrivacySummary}" Style="{StaticResource BodySecondary}" />
                            <CheckBox Content="Remove GPS metadata from derived working copies" IsChecked="{Binding RemoveGpsFromWorkingCopies}" Margin="0,14,0,0" AutomationProperties.HelpText="Original photographs remain unchanged." />
                            <TextBlock Text="Original photographs remain byte-for-byte unchanged." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="26,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Reconstruction" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Advanced engine parameters remain hidden until explicitly enabled." Style="{StaticResource BodySecondary}" Margin="0,4,0,14" />
                            <CheckBox Content="Enable Expert Mode" IsChecked="{Binding ExpertMode}" />
                            <Border Style="{StaticResource WarningBadge}" CornerRadius="8" Padding="12" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource StatusWarning}" /><TextBlock Grid.Column="1" Text="Expert parameters can substantially increase memory, storage use and processing time." Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" /></Grid></Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Storage &amp; diagnostics" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Inspect and safely reclaim derived files while preserving originals, metadata, primary models and exports." Style="{StaticResource BodySecondary}" Margin="0,4,0,14" />
                            <Label Content="Project" Target="{Binding ElementName=ProjectPicker}" />
                            <ComboBox x:Name="ProjectPicker" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" AutomationProperties.Name="Maintenance project" />
                            <Border Style="{StaticResource InsetCard}" Padding="14" Margin="0,12,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentPrimary}" FontSize="16" /><TextBlock Grid.Column="1" Text="{Binding StorageSummary}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" /></Grid></Border>
                            <WrapPanel>
                                <Button Content="Refresh storage" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Compact project" Command="{Binding CompactCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                                <Button Content="Create diagnostic report" Command="{Binding DiagnosticCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                                <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource StatusInfo}" TextWrapping="Wrap" Margin="2,10,2,0" />
                            <TextBlock Text="Diagnostic reports exclude photos, models, GPS and imported source paths." Foreground="{StaticResource StatusSuccess}" FontSize="11" Margin="2,7,2,0" />
                            <Border Background="{StaticResource StatusErrorSurface}" BorderBrush="#75404A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource StatusError}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource InsetCard}" Padding="16" Margin="0,16,0,24">
                        <Grid><StackPanel><TextBlock Text="SpatialForge 0.2.1" FontWeight="SemiBold" /><TextBlock Text="Local 3D reconstruction for Windows" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,3,0,0" /></StackPanel><TextBlock Text="No telemetry · no uploads · no accounts" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
