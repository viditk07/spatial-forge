<UserControl x:Class="SpatialForge.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings &amp; local maintenance" FontSize="28" FontWeight="SemiBold" />
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="24" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="Privacy" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PrivacySummary}" TextWrapping="Wrap"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,16" />
                    <CheckBox Content="Remove GPS metadata from derived working copies"
                              IsChecked="{Binding RemoveGpsFromWorkingCopies}" Margin="0,6" />
                    <CheckBox Content="Enable Expert Mode" IsChecked="{Binding ExpertMode}" Margin="0,6" />
                    <TextBlock Text="Expert parameters can substantially increase memory and storage use."
                               Foreground="#D8A64B" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Project maintenance" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="Name" Margin="0,14,0,8" />
                    <TextBlock Text="{Binding StorageSummary}" Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" Margin="0,6,0,12" />
                    <WrapPanel>
                        <Button Content="Refresh storage" Command="{Binding RefreshCommand}" />
                        <Button Content="Compact project" Command="{Binding CompactCommand}" />
                        <Button Content="Create diagnostic report" Command="{Binding DiagnosticCommand}" />
                        <Button Content="Open logs folder" Command="{Binding OpenLogsCommand}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding OperationStatus}" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" Margin="4,12,4,0" />
                    <TextBlock Text="Diagnostics exclude photographs, models, GPS, and imported source paths."
                               Foreground="#56C59A" FontSize="11" Margin="4,8,4,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FF8C8C" TextWrapping="Wrap" Margin="4,8" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
