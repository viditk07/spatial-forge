<UserControl x:Class="SpatialForge.Desktop.Views.HardwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Hardware capability report" Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32" MaxWidth="1240">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <StackPanel><TextBlock Text="Hardware capability" Style="{StaticResource PageTitle}" /><TextBlock Text="A local readiness report for reconstruction quality, speed and compatibility." Style="{StaticResource PageSubtitle}" /></StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Open diagnostics" Style="{StaticResource SecondaryButton}" IsEnabled="False" ToolTip="Create a diagnostic report from Settings." Margin="0,0,10,0" />
                    <Button Content="↻  Refresh report" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Refresh hardware report" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource SurfaceSecondary}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource StatusSuccessSurface}" VerticalAlignment="Top"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource StatusSuccess}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Grid.Column="1" Margin="4,0,24,0"><TextBlock Text="RECONSTRUCTION READINESS" Style="{StaticResource Eyebrow}" /><TextBlock Text="Ready for local processing" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="SpatialForge selected a safe default based on detected memory and acceleration." Style="{StaticResource BodySecondary}" Margin="0,5,0,0" /></StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BorderSubtle}" />
                    <StackPanel Grid.Column="3" Margin="24,0,0,0"><TextBlock Text="RECOMMENDED PRESET" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding Profile.DisplayRecommendedPreset, TargetNullValue=Evaluating…}" Foreground="{StaticResource AccentPrimary}" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0" /><TextBlock Text="You can choose another preset before processing." Style="{StaticResource BodySecondary}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid><TextBlock Text="System overview" Style="{StaticResource SectionTitle}" /><Border Style="{StaticResource InfoBadge}" HorizontalAlignment="Right"><TextBlock Text="LOCAL PROBE" Foreground="{StaticResource StatusInfo}" FontSize="10" FontWeight="SemiBold" /></Border></Grid>
                        <Separator Margin="0,16,0,8" />
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Operating system" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.DisplayOperatingSystem, TargetNullValue=Detecting…}" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Processor" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.DisplayCpuModel, TargetNullValue=Detecting…}" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Logical cores" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.LogicalCoreCount, TargetNullValue=Not detected}" FontWeight="SemiBold" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Installed memory" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.MemoryTotalMb, StringFormat={}{0:N0} MB, TargetNullValue=Not detected}" FontWeight="SemiBold" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Available memory" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.MemoryAvailableMb, StringFormat={}{0:N0} MB, TargetNullValue=Not detected}" FontWeight="SemiBold" /></Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid><TextBlock Text="Graphics &amp; acceleration" Style="{StaticResource SectionTitle}" /><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentPrimary}" FontSize="18" HorizontalAlignment="Right" /></Grid>
                        <Separator Margin="0,16,0,8" />
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Graphics adapter" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.DisplayGpuModel, TargetNullValue=Detecting…}" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="GPU memory" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.DisplayGpuMemory, TargetNullValue=Unavailable}" FontWeight="SemiBold" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="CUDA" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.DisplayCudaStatus, TargetNullValue=Unavailable}" FontWeight="SemiBold" Foreground="{StaticResource StatusInfo}" /></Grid>
                        <Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="OpenGL" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding Profile.DisplayOpenGlVersion, TargetNullValue=Not detected}" FontWeight="SemiBold" /></Grid>
                        <Border Style="{StaticResource InsetCard}" Padding="12" Margin="0,10,0,0"><TextBlock Text="Dense reconstruction depends on the selected engine and compatible GPU support. CPU-safe modes remain available." Style="{StaticResource BodySecondary}" FontSize="12" /></Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="6" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid><StackPanel><TextBlock Text="Reconstruction engines" Style="{StaticResource SectionTitle}" /><TextBlock Text="External tools are detected on this computer; missing tools are never downloaded automatically." Style="{StaticResource BodySecondary}" Margin="0,4,0,0" /></StackPanel><Border Style="{StaticResource SuccessBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="NO NETWORK CHECKS" Foreground="{StaticResource StatusSuccess}" FontSize="10" FontWeight="SemiBold" /></Border></Grid>
                    <ItemsControl ItemsSource="{Binding Dependencies}" Margin="0,16,0,0">
                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InsetCard}" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="170" /><ColumnDefinition Width="130" /><ColumnDefinition /></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource SurfaceInteractive}"><TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" /><Border Grid.Column="2" Style="{StaticResource InfoBadge}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding AvailabilityLabel}" Foreground="{StaticResource StatusInfo}" FontSize="11" FontWeight="SemiBold" /></Border><TextBlock Grid.Column="3" Text="{Binding VersionLabel}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
