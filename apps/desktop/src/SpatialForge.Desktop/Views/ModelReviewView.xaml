<UserControl x:Class="SpatialForge.Desktop.Views.ModelReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Loaded="OnLoaded" AutomationProperties.Name="Model review workspace">
    <Grid Background="{StaticResource SidebarBackground}">
        <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="*" /><RowDefinition Height="30" /></Grid.RowDefinitions>
        <Border Background="{StaticResource SurfacePrimary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Model review" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,3,0,0" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource SuccessBadge}" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource StatusSuccess}" Margin="0,0,6,0" /><TextBlock Text="Local viewport" Foreground="{StaticResource StatusSuccess}" FontSize="10" FontWeight="SemiBold" /></StackPanel></Border>
                    <ComboBox Width="260" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="DisplayModelType" ToolTip="Select a reconstruction layer" SelectionChanged="OnModelSelectionChanged" AutomationProperties.Name="Active model layer" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource SurfacePrimary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0" Padding="14">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Scene layers" Style="{StaticResource CardTitle}" /><TextBlock Text="{Binding Models.Count}" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" /></Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" SelectionChanged="OnModelSelectionChanged" AutomationProperties.Name="Scene layers">
                        <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource InsetCard}" Padding="10" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayModelType}" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="{Binding Format}" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,2,0,0" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="3" Style="{StaticResource InsetCard}" Padding="11"><TextBlock Text="Viewer layer toggles control cameras, sparse cloud, dense cloud, mesh and textures independently." Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" /></Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#080D12">
                <wv2:WebView2 x:Name="Viewer" DefaultBackgroundColor="#080D12" AutomationProperties.Name="Interactive 3D viewport" />
                <Border Background="#E6080D12" CornerRadius="14" Padding="30" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedModel}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel><Border Width="62" Height="62" CornerRadius="18" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center"><TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource AccentPrimary}" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="No completed model yet" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,17,0,0" /><TextBlock Text="Complete a reconstruction to inspect geometry, calibrate scale, measure, crop and export." Style="{StaticResource BodySecondary}" TextAlignment="Center" Margin="0,7,0,0" /></StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="{StaticResource SurfacePrimary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Inspector" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="MODEL STATISTICS" Style="{StaticResource Eyebrow}" Margin="0,20,0,9" />
                    <Border Style="{StaticResource InsetCard}" Padding="12"><StackPanel>
                        <Grid Margin="0,4"><TextBlock Text="Vertices" Foreground="{StaticResource TextSecondary}" /><TextBlock Text="{Binding SelectedModel.VertexCount, StringFormat={}{0:N0}, TargetNullValue=Unavailable}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                        <Grid Margin="0,4"><TextBlock Text="Faces" Foreground="{StaticResource TextSecondary}" /><TextBlock Text="{Binding SelectedModel.FaceCount, StringFormat={}{0:N0}, TargetNullValue=Unavailable}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                        <Grid Margin="0,4"><TextBlock Text="File size" Foreground="{StaticResource TextSecondary}" /><TextBlock Text="{Binding SelectedModel.FileSizeBytes, StringFormat={}{0:N0} bytes, TargetNullValue=Unavailable}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                        <Grid Margin="0,4"><TextBlock Text="Format" Foreground="{StaticResource TextSecondary}" /><TextBlock Text="{Binding SelectedModel.Format, TargetNullValue=Unavailable}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid>
                    </StackPanel></Border>
                    <TextBlock Text="SPATIAL CALIBRATION" Style="{StaticResource Eyebrow}" Margin="0,20,0,9" />
                    <Border Style="{StaticResource InsetCard}" Padding="12"><StackPanel><Grid Margin="0,4"><TextBlock Text="Scale factor" Foreground="{StaticResource TextSecondary}" /><TextBlock Text="{Binding SelectedModel.ScaleFactor, StringFormat={}{0:G6}, TargetNullValue=Uncalibrated}" HorizontalAlignment="Right" FontWeight="SemiBold" /></Grid><TextBlock Text="{Binding SelectedModel.CoordinateSystem, TargetNullValue=Arbitrary coordinates}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,6,0,0" /><TextBlock Text="Select Scale in the viewport, choose two points, then enter a known distance." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" /></StackPanel></Border>
                    <TextBlock Text="VIEWPORT TOOLS" Style="{StaticResource Eyebrow}" Margin="0,20,0,9" />
                    <TextBlock Text="Orbit · Pan · Zoom · Fit · Select · Crop · Measure · Scale · Wireframe · Screenshot" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" />
                    <Border Style="{StaticResource InfoBadge}" CornerRadius="8" Padding="11" Margin="0,18,0,0"><TextBlock Text="Export presets and advanced output controls are available inside the viewport panel." Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" /></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfacePrimary}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid><TextBlock Text="Orbit tool · Ready" Foreground="{StaticResource TextMuted}" FontSize="10" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{StaticResource StatusSuccess}" Margin="0,0,6,0" /><TextBlock Text="WebView2 offline renderer" Foreground="{StaticResource TextMuted}" FontSize="10" /></StackPanel></Grid>
        </Border>
        <Border Grid.Row="1" Background="{StaticResource StatusErrorSurface}" BorderBrush="#75404A" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Bottom" Margin="234,14,264,14">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource StatusError}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
