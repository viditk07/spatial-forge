<UserControl x:Class="SpatialForge.Desktop.Views.ImageReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Image quality review" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Warnings are guidance only. SpatialForge never deletes photographs automatically."
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,7,0,10" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="All" Command="{Binding ShowAllCommand}" />
                <Button Content="Good" Command="{Binding ShowGoodCommand}" />
                <Button Content="Review" Command="{Binding ShowReviewCommand}" />
                <Button Content="Excluded" Command="{Binding ShowExcludedCommand}" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding VisibleImages}" SelectedItem="{Binding SelectedImage}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="210" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12" Margin="5">
                            <StackPanel>
                                <Image Source="{Binding ThumbnailPath}" Height="118" Stretch="UniformToFill"
                                       Margin="0,0,0,8" />
                                <TextBlock Text="{Binding OriginalFilename}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding QualityStatus}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                                <TextBlock Text="{Binding QualityMetric.ExposureStatus}" Foreground="{StaticResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding QualityMetric.BlurScore, StringFormat=Blur score: {0:F0}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="20" Margin="18,0,0,0">
                <StackPanel DataContext="{Binding SelectedImage}">
                    <TextBlock Text="Selected photograph" Foreground="{StaticResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding OriginalFilename, TargetNullValue=Select an image}"
                               FontSize="18" FontWeight="SemiBold" Margin="0,8,0,18" />
                    <Image Source="{Binding ThumbnailPath}" Height="220" Stretch="Uniform"
                           Margin="0,0,0,12" />
                    <Button Content="Open full-screen preview" Click="OpenPreview_Click"
                            Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Width, StringFormat=Width: {0}px}" />
                    <TextBlock Text="{Binding Height, StringFormat=Height: {0}px}" />
                    <TextBlock Text="{Binding FocalLengthMm, StringFormat=Focal length: {0:F1} mm}" />
                    <TextBlock Text="{Binding QualityMetric.FeatureCountEstimate, StringFormat=Feature estimate: {0}}" />
                    <TextBlock Text="{Binding WarningExplanation}" TextWrapping="Wrap"
                               Foreground="#D8A64B" Margin="0,12,0,0" />
                    <CheckBox Content="Include in reconstruction" IsChecked="{Binding IsIncluded}"
                              Command="{Binding SaveInclusionCommand}" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding InclusionError}" Foreground="#F19AA7" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
