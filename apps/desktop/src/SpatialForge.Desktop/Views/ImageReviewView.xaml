<UserControl x:Class="SpatialForge.Desktop.Views.ImageReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Image quality review">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Photo quality review" Style="{StaticResource PageTitle}" /><TextBlock Text="Quality warnings are guidance only. SpatialForge never deletes photos automatically." Style="{StaticResource PageSubtitle}" /></StackPanel>
            <Border Style="{StaticResource SuccessBadge}" HorizontalAlignment="Right" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource StatusSuccess}" Margin="0,0,6,0" /><TextBlock Text="Originals protected" Foreground="{StaticResource StatusSuccess}" FontSize="11" FontWeight="SemiBold" /></StackPanel></Border>
        </Grid>
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding ShowAllCommand}" Style="{StaticResource NavButton}" Tag="{Binding IsAllFilter}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="All  " /><TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource TextMuted}" /></StackPanel></Button>
                <Button Command="{Binding ShowGoodCommand}" Style="{StaticResource NavButton}" Tag="{Binding IsGoodFilter}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource StatusSuccess}" Margin="0,0,7,0" /><TextBlock Text="Good  " /><TextBlock Text="{Binding GoodCount}" Foreground="{StaticResource TextMuted}" /></StackPanel></Button>
                <Button Command="{Binding ShowReviewCommand}" Style="{StaticResource NavButton}" Tag="{Binding IsReviewFilter}" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource StatusWarning}" Margin="0,0,7,0" /><TextBlock Text="Review  " /><TextBlock Text="{Binding ReviewCount}" Foreground="{StaticResource TextMuted}" /></StackPanel></Button>
                <Button Command="{Binding ShowExcludedCommand}" Style="{StaticResource NavButton}" Tag="{Binding IsExcludedFilter}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource StatusError}" Margin="0,0,7,0" /><TextBlock Text="Excluded  " /><TextBlock Text="{Binding ExcludedCount}" Foreground="{StaticResource TextMuted}" /></StackPanel></Button>
            </StackPanel>
            <TextBlock Text="Select a photo to inspect its capture metrics." Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="340" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource InsetCard}" Padding="10">
                <ListBox ItemsSource="{Binding VisibleImages}" SelectedItem="{Binding SelectedImage}" AutomationProperties.Name="Photo thumbnails">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource SelectableCardItem}"><Setter Property="Width" Value="206" /><Setter Property="Padding" Value="9" /><Setter Property="Margin" Value="0,0,10,10" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Height="112" Background="{StaticResource SurfaceInteractive}" CornerRadius="7" ClipToBounds="True"><Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" /></Border><TextBlock Text="{Binding OriginalFilename}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" /><Grid Margin="0,5,0,0"><TextBlock Text="{Binding QualityStatus}" Foreground="{StaticResource StatusInfo}" FontSize="11" /><TextBlock Text="{Binding QualityMetric.BlurScore, StringFormat=Focus {0:F0}}" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" /></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding SelectedImage}">
                        <TextBlock Text="PHOTO INSPECTOR" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding OriginalFilename, TargetNullValue=Select a photograph}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,14" TextTrimming="CharacterEllipsis" />
                        <Border Height="210" Background="{StaticResource SidebarBackground}" CornerRadius="9" ClipToBounds="True"><Image Source="{Binding ThumbnailPath}" Stretch="Uniform" /></Border>
                        <Button Content="Open full-screen preview" Click="OpenPreview_Click" Style="{StaticResource SecondaryButton}" Margin="0,12,0,16" />
                        <TextBlock Text="CAPTURE METRICS" Style="{StaticResource Eyebrow}" Margin="0,0,0,8" />
                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Resolution" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" HorizontalAlignment="Right"><Run Text="{Binding Width}" /><Run Text=" × " /><Run Text="{Binding Height}" /></TextBlock></Grid>
                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Focal length" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding FocalLengthMm, StringFormat={}{0:F1} mm, TargetNullValue=Unavailable}" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Feature estimate" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding QualityMetric.FeatureCountEstimate, TargetNullValue=Unavailable}" HorizontalAlignment="Right" /></Grid>
                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="Exposure" Foreground="{StaticResource TextSecondary}" /><TextBlock Grid.Column="1" Text="{Binding QualityMetric.ExposureStatus, TargetNullValue=Not analysed}" HorizontalAlignment="Right" /></Grid>
                        <Border Style="{StaticResource WarningBadge}" CornerRadius="8" Padding="12" Margin="0,14,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{StaticResource StatusWarning}" /><TextBlock Grid.Column="1" Text="{Binding WarningExplanation}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" FontSize="12" /></Grid></Border>
                        <CheckBox Content="Include in reconstruction" IsChecked="{Binding IsIncluded}" Command="{Binding SaveInclusionCommand}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding InclusionError}" Foreground="{StaticResource StatusError}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
