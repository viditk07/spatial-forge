<UserControl x:Class="SpatialForge.Desktop.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="44">
        <Border Background="#2B2024" BorderBrush="#81404B" BorderThickness="1" CornerRadius="8"
                Padding="28" MaxWidth="760" VerticalAlignment="Top" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="23" FontWeight="SemiBold" Foreground="#F19AA7" />
                <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <TextBlock Text="Recommended action" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,22,0,5" />
                <TextBlock Text="{Binding RecommendedAction}" TextWrapping="Wrap" />
                <Expander Header="Technical details" Margin="0,24,0,0">
                    <TextBox Text="{Binding TechnicalDetails}" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas" MinHeight="100" />
                </Expander>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
