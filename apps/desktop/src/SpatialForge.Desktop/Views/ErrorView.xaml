<UserControl x:Class="SpatialForge.Desktop.Views.ErrorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="SpatialForge error">
    <Grid Margin="32">
        <Border Style="{StaticResource Card}" Background="{StaticResource StatusErrorSurface}" BorderBrush="#75404A" Padding="30" MaxWidth="780" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="#552531" VerticalAlignment="Top"><TextBlock Text="&#xEA39;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource StatusError}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="ATTENTION REQUIRED" Style="{StaticResource Eyebrow}" Foreground="{StaticResource StatusError}" />
                    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource BodySecondary}" FontSize="14" Margin="0,12,0,0" />
                    <Border Style="{StaticResource InsetCard}" Padding="14" Margin="0,20,0,0"><StackPanel><TextBlock Text="RECOMMENDED ACTION" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding RecommendedAction}" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Border>
                    <Expander Header="Technical details" Margin="0,18,0,0"><TextBox Text="{Binding TechnicalDetails, TargetNullValue=No additional technical details are available.}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" MinHeight="100" Margin="0,10,0,0" /></Expander>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
