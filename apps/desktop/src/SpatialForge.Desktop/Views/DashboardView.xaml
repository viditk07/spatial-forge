<UserControl x:Class="SpatialForge.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="SpatialForge dashboard">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32" MaxWidth="1320" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Your local workspace for reconstruction projects and device readiness."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" AutomationProperties.Name="Refresh dashboard" />
                    <Button Content="＋  New project" Command="{Binding NewProjectCommand}" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="Create a new project" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource SurfaceSecondary}" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="2*" MinWidth="260" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1.1*" MinWidth="190" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="1.1*" MinWidth="190" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentSoft}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21"
                                   Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="4,0,24,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="THIS COMPUTER" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SuccessBadge}" Margin="12,0,0,0" Padding="8,3">
                                <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource StatusSuccess}" Margin="0,0,6,0" /><TextBlock Text="Ready" Foreground="{StaticResource StatusSuccess}" FontSize="11" FontWeight="SemiBold" /></StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Hardware.DisplayCpuModel, TargetNullValue=Detecting processor…}"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,9,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Hardware.DisplayGpuModel, TargetNullValue=CPU-compatible graphics mode}"
                                   Style="{StaticResource BodySecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource BorderSubtle}" />
                    <StackPanel Grid.Column="3" Margin="24,0">
                        <TextBlock Text="RECOMMENDED PRESET" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding Hardware.DisplayRecommendedPreset, TargetNullValue=Evaluating hardware…}"
                                   Foreground="{StaticResource AccentPrimary}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="Matched to available memory and acceleration."
                                   Style="{StaticResource BodySecondary}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="4" Background="{StaticResource BorderSubtle}" />
                    <StackPanel Grid.Column="5" Margin="24,0,0,0">
                        <TextBlock Text="RECONSTRUCTION ENGINE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding DependencySummary}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="Checked locally; no network request is made."
                                   Style="{StaticResource BodySecondary}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <TextBlock Text="Recent projects" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Select a project to continue where you left off." Style="{StaticResource BodySecondary}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="6">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ListBox ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject}"
                         AutomationProperties.Name="Recent projects">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Style.Triggers><DataTrigger Binding="{Binding RecentProjects.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource SurfaceInteractive}">
                                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayProjectType}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="STATUS" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="{StaticResource StatusInfo}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="UPDATED" Style="{StaticResource Eyebrow}" />
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Padding="40" MinHeight="260">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding RecentProjects.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                        <Border Width="72" Height="72" CornerRadius="20" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="&#xE81E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Forge your first spatial model" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
                        <TextBlock Text="Create a project, add overlapping smartphone photos, and reconstruct locally on this computer."
                                   Style="{StaticResource BodySecondary}" TextAlignment="Center" Margin="0,8,0,18" />
                        <Button Content="Create new project" Command="{Binding NewProjectCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,16,0,0">
                    <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding RecentProjects.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="50" Height="36" CornerRadius="6" Background="{StaticResource SurfaceInteractive}" ClipToBounds="True" Margin="0,0,10,0"><Image Source="{Binding SelectedThumbnailPath}" Stretch="UniformToFill" /></Border>
                        <TextBlock Text="{Binding SelectedStorageSummary}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Delete" Command="{Binding DeleteProjectCommand}" Style="{StaticResource DangerButton}" Margin="0,0,10,0" />
                        <Button Content="Open selected project" Command="{Binding OpenProjectCommand}" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
