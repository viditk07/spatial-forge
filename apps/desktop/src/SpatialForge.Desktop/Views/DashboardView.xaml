<UserControl x:Class="SpatialForge.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LocalProcessingLabel}" Foreground="#56C59A" Margin="0,8,0,0" />
            </StackPanel>
            <Button Content="New project" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="{StaticResource AccentBrush}" Command="{Binding NewProjectCommand}" />
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="THIS COMPUTER" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Hardware.CpuModel, TargetNullValue=Detecting hardware…}"
                               FontSize="16" Margin="0,7,0,0" />
                    <TextBlock Text="{Binding Hardware.GpuModel, TargetNullValue=CPU-compatible mode}"
                               Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DependencySummary}" Foreground="{StaticResource SecondaryTextBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="RECOMMENDED MODE" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" />
                    <TextBlock Text="{Binding Hardware.RecommendedPreset, TargetNullValue=Evaluating…}"
                               Foreground="{StaticResource AccentBrush}" FontSize="16" Margin="0,7,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="Recent projects" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Image Source="{Binding SelectedThumbnailPath}" Width="64" Height="44"
                       Stretch="UniformToFill" Margin="0,0,10,0" />
                <TextBlock Text="{Binding SelectedStorageSummary}" VerticalAlignment="Center"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
            <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ListBox ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="7" Padding="16" Margin="0,0,0,8">
                            <Grid Width="760">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProjectType}" Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding UpdatedAt, StringFormat={}{0:g}}"
                                               Foreground="{StaticResource SecondaryTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="1" Content="Open selected project" Command="{Binding OpenProjectCommand}"
                    HorizontalAlignment="Right" Margin="0,12,0,0" />
            <Button Grid.Row="1" Content="Delete selected" Command="{Binding DeleteProjectCommand}"
                    HorizontalAlignment="Left" Margin="0,12,0,0" Foreground="#FF8C8C" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
