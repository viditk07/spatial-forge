<UserControl x:Class="SpatialForge.Desktop.Views.ProcessingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" AutomationProperties.Name="Local reconstruction progress">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Local reconstruction" Style="{StaticResource PageTitle}" /><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PageSubtitle}" /></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                <Button Content="Retry failed job" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource SurfaceSecondary}" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal"><Border Style="{StaticResource InfoBadge}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{StaticResource AccentPrimary}" Margin="0,0,7,0" /><TextBlock Text="PROCESSING LOCALLY" Foreground="{StaticResource AccentPrimary}" FontSize="10" FontWeight="Bold" /></StackPanel></Border><TextBlock Text="{Binding Job.DisplayCurrentStage, TargetNullValue=Preparing pipeline}" FontWeight="SemiBold" FontSize="16" Margin="12,2,0,0" /></StackPanel>
                    <TextBlock Text="{Binding Job.ProgressPercent, StringFormat={}{0:F0}%}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right" />
                </Grid>
                <ProgressBar Grid.Row="2" Maximum="100" Value="{Binding Job.ProgressPercent}" AutomationProperties.Name="Overall reconstruction progress" />
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="RESOURCE USE" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding ResourceSummary}" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="CAPTURE" Style="{StaticResource Eyebrow}" /><TextBlock Text="{Binding ProcessingDetails}" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0" TextWrapping="Wrap" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="PRIVACY" Style="{StaticResource Eyebrow}" /><TextBlock Text="No uploads · local worker process" Foreground="{StaticResource StatusSuccess}" Margin="0,5,0,0" /></StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Pipeline timeline" Style="{StaticResource SectionTitle}" /><TextBlock Text="Completed stages are checkpointed for safe retry." Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Stages}" AutomationProperties.Name="Pipeline stages">
                        <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource InsetCard}" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource SurfaceInteractive}"><TextBlock Text="{Binding SequenceNumber}" Foreground="{StaticResource AccentPrimary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><ProgressBar Maximum="100" Value="{Binding ProgressPercent}" Height="3" Margin="0,6,20,0" /></StackPanel><Border Grid.Column="2" Style="{StaticResource InfoBadge}" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayStatus}" Foreground="{StaticResource StatusInfo}" FontSize="10" FontWeight="SemiBold" /></Border></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="Technical logs" Style="{StaticResource SectionTitle}" /><TextBlock Text="Hidden by default; available for troubleshooting." Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,3,0,0" /></StackPanel><Button Content="Load latest logs" Command="{Binding LoadLogsCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" /></Grid>
                    <TextBox Grid.Row="2" Text="{Binding TechnicalLogs}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" AutomationProperties.Name="Technical processing logs" />
                </Grid>
            </Border>
            <Border Grid.ColumnSpan="3" Background="{StaticResource StatusErrorSurface}" BorderBrush="#75404A" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Bottom" Margin="0,12,0,0">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource StatusError}" TextWrapping="Wrap" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
