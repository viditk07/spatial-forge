<Window x:Class="SpatialForge.Desktop.SpatialForgeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource SurfaceElevated}" Foreground="{StaticResource TextPrimary}"
        Title="SpatialForge" AutomationProperties.Name="SpatialForge confirmation">
    <Border BorderBrush="{StaticResource BorderStrong}" BorderThickness="1" Padding="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentSoft}" VerticalAlignment="Top"><TextBlock x:Name="DialogIcon" Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <StackPanel Grid.Column="1"><TextBlock x:Name="DialogTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="DialogKicker" Text="LOCAL ACTION" Style="{StaticResource Eyebrow}" Margin="0,5,0,0" /></StackPanel>
            </Grid>
            <TextBlock x:Name="DialogMessage" Grid.Row="2" Style="{StaticResource BodySecondary}" FontSize="14" />
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" MinWidth="100" Margin="0,0,10,0" IsCancel="True" />
                <Button x:Name="ConfirmButton" Content="Continue" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" MinWidth="110" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
