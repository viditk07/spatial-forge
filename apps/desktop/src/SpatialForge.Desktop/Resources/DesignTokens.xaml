<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SpatialForge dark-first semantic colour system. -->
    <Color x:Key="AppBackgroundColor">#0B1118</Color>
    <Color x:Key="SidebarBackgroundColor">#080D13</Color>
    <Color x:Key="SurfacePrimaryColor">#121A24</Color>
    <Color x:Key="SurfaceSecondaryColor">#17222E</Color>
    <Color x:Key="SurfaceElevatedColor">#1D2A38</Color>
    <Color x:Key="SurfaceInteractiveColor">#223241</Color>
    <Color x:Key="AccentPrimaryColor">#3ABFF8</Color>
    <Color x:Key="AccentPrimaryHoverColor">#64CFFF</Color>
    <Color x:Key="AccentPrimaryPressedColor">#1F9ED5</Color>
    <Color x:Key="AccentSoftColor">#17374A</Color>
    <Color x:Key="TextPrimaryColor">#F4F8FC</Color>
    <Color x:Key="TextSecondaryColor">#B4C2CF</Color>
    <Color x:Key="TextMutedColor">#8595A5</Color>
    <Color x:Key="TextDisabledColor">#687785</Color>
    <Color x:Key="BorderSubtleColor">#293846</Color>
    <Color x:Key="BorderStrongColor">#415567</Color>
    <Color x:Key="FocusOutlineColor">#78D7FF</Color>
    <Color x:Key="StatusSuccessColor">#59D49A</Color>
    <Color x:Key="StatusSuccessSurfaceColor">#123127</Color>
    <Color x:Key="StatusWarningColor">#F2BC66</Color>
    <Color x:Key="StatusWarningSurfaceColor">#382B18</Color>
    <Color x:Key="StatusErrorColor">#FF8796</Color>
    <Color x:Key="StatusErrorSurfaceColor">#3A1C24</Color>
    <Color x:Key="StatusInfoColor">#79C7FF</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackground" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfacePrimary" Color="{StaticResource SurfacePrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceSecondary" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceElevated" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceInteractive" Color="{StaticResource SurfaceInteractiveColor}" />
    <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHover" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentPrimaryPressed" Color="{StaticResource AccentPrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabled" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="FocusOutline" Color="{StaticResource FocusOutlineColor}" />
    <SolidColorBrush x:Key="StatusSuccess" Color="{StaticResource StatusSuccessColor}" />
    <SolidColorBrush x:Key="StatusSuccessSurface" Color="{StaticResource StatusSuccessSurfaceColor}" />
    <SolidColorBrush x:Key="StatusWarning" Color="{StaticResource StatusWarningColor}" />
    <SolidColorBrush x:Key="StatusWarningSurface" Color="{StaticResource StatusWarningSurfaceColor}" />
    <SolidColorBrush x:Key="StatusError" Color="{StaticResource StatusErrorColor}" />
    <SolidColorBrush x:Key="StatusErrorSurface" Color="{StaticResource StatusErrorSurfaceColor}" />
    <SolidColorBrush x:Key="StatusInfo" Color="{StaticResource StatusInfoColor}" />

    <!-- Compatibility aliases retained while older templates migrate. -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfacePrimaryColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource TextSecondaryColor}" />

    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">10</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">14</CornerRadius>
    <Thickness x:Key="PagePadding">32</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Duration x:Key="MotionFast">0:0:0.12</Duration>
    <Duration x:Key="MotionStandard">0:0:0.2</Duration>

    <DropShadowEffect x:Key="ShadowElevated" BlurRadius="18" Direction="270"
                      Opacity="0.18" ShadowDepth="5" Color="#000000" />
</ResourceDictionary>
