# SpatialForge repository ignore rules

# Local environment and toolchains
.venv/
.env
.env.*
!.env.example
.dotnet/
.dotnet-home/
.agents/
.codex/

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Node / viewer
node_modules/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# .NET / desktop
bin/
obj/
TestResults/
*.user
*.suo
*.rsuser

# Local databases and generated project data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
SpatialForgeProjects/
project_*/
samples/generated/

# Build and packaging outputs
build/
artifacts/
publish/
release/
*.msix
*.msixbundle
*.appx
*.appxbundle
*.exe
*.msi
*.nupkg
*.whl
*.tar.gz

# External engine binaries are not committed until redistribution is approved.
engines/**/bin/
engines/**/*.exe
engines/**/*.dll
engines/**/*.pdb
engines/**/*.zip
engines/**/*.7z

# Logs and diagnostics
*.log
logs/
diagnostic-reports/

# IDE and OS metadata
.idea/
.vs/
.vscode/
.DS_Store
Thumbs.db
